{
	"custom/powermenu": {
		"format": "",
		"tooltip": false,
		
		"menu": "on-click",
		"menu-file": "~/.config/sway/waybar/function_modules/power_menu.xml",

		"menu-actions": {
			"shutdown": "systemctl poweroff",
			"reboot": "systemctl restart",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
	},
}
