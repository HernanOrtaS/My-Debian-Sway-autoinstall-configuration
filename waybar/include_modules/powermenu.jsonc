{
	"custom/powermenu": {
		"format": "",
		"tooltip": false,
		
		"menu": "on-click",
		"menu-file": "~/.config/sway/waybar/function_modules/power_menu.xml",

		"menu-actions": {
			"shutdown": "systemctl poweroff",
			"reboot": "systemctl reboot",
			"suspend": "swaylock -f --config ~/.config/sway/swaylock/config.conf && systemctl suspend",
			"hibernate": "swaylock -f --config ~/.config/sway/swaylock/config.conf && systemctl hibernate",
			"block": "swaylock -f --config ~/.config/sway/swaylock/config.conf",
		}
	},
}
