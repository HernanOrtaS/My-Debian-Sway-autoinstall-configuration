{
	"network": {
		"format": "{ifname}",
		"format-wifi": "  {essid}",
		"format-ethernet": " Ethernet",
		"format-disconnected": "Disconnected",
		"on-click": "nm-connection-editor",
		
		"tooltip-format": "{ifname}",
		"tooltip-format-wifi": "Network: {essid} \nSignal: ({signalStrength}%) \nIP: {ipaddr} \nUp: {bandwidthUpBits} \nDown: {bandwidthDownBits} \nTotal: {bandwidthTotalBits}:",
		"tooltip-format-ethernet": "IP: {ipaddr}",
		"tooltip-format-disconnected": "Disconnected",
		
		"family": "ipv4",
		"max-length": 50,
	}
}
