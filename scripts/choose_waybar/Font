#!/bin/bash
RESET_WAYBAR="$HOME/.config/sway/waybar/start-waybar.sh"

COLOR_DIR="$HOME/.config/sway/waybar/waybar_styles/waybar_colors/"
CURRENT="$HOME/.config/sway/waybar/waybar_styles/secondary.css"

HEIGHT=20
WIDTH=50
CHOICE_HEIGHT=10

export DIALOGRC="$HOME/.config/sway/scripts/choose_waybar/dialogrc"

OPTIONS=()

while IFS= read -r -d '' FILE; do
    NAME=$(basename "$FILE")
    OPTIONS+=("$NAME" "")
done < <(
    find "$COLOR_DIR" -maxdepth 1 -type f -name '*.css' \
        ! -name 'current.css' -print0 | sort -z
)

if [ ${#OPTIONS[@]} -eq 0 ]; then
    dialog --title "Secondary Color" \
        --msgbox "No CSS files found in:\n$COLOR_DIR" 8 50
    clear
    exit 1
fi

SELECTED=$(dialog --clear \
    --title "Font Color" \
    --menu "Select a font color:" \
    "$HEIGHT" "$WIDTH" "$CHOICE_HEIGHT" \
    "${OPTIONS[@]}" \
    2>&1 >/dev/tty)

clear

if [ -n "$SELECTED" ]; then
    COLOR=$(cat "$COLOR_DIR/$SELECTED")

    printf '@define-color secondary-color rgba(%s, 1.00);\n' "$COLOR" > "$CURRENT"
fi

nohup bash "$RESET_WAYBAR" >/dev/null 2>&1 &
clear