#!/bin/bash

OPACITY_FILE="$HOME/.config/sway/waybar/waybar_styles/opacity"

export DIALOGRC="$HOME/.config/sway/scripts/choose_waybar/dialogrc"

INPUT=$(dialog --clear \
    --title "Primary Color Opacity" \
    --inputbox "Enter opacity (0-100):" \
    10 40 "90" \
    2>&1 >/dev/tty)

STATUS=$?
clear

if (( STATUS != 0 )); then
    exit 0
fi

if [[ "$INPUT" =~ ^[0-9]{1,3}$ ]] &&
   (( 10#$INPUT >= 0 && 10#$INPUT <= 100 )); then

    if (( 10#$INPUT == 100 )); then
        printf '1.00\n' > "$OPACITY_FILE"
    else
        printf '0.%02d\n' "$((10#$INPUT))" > "$OPACITY_FILE"
    fi

    exit 0
fi

dialog --clear \
    --title "Invalid Opacity" \
    --msgbox "Enter a whole number from 0 to 100." 8 45

clear
exit 1
